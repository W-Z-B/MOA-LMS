# Copy to .env and fill in. Placeholders only; never commit real values.
DOMAIN=lms.localhost
PUBLIC_ORIGINS=https://lms.localhost:8445
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_scripts/gen-secret.sh
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=lms.localhost,localhost,api,lms-api
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_byte_urlsafe_base64
DB_HOST=db
DB_PORT=5432
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=CHANGE_ME
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lms@gsa.edu.gy
TZ=America/Guyana
# Optional limits; the defaults suit production.
# SESSION_IDLE_MINUTES=30              # sign out after this long without activity (8 hours at most in all)
# LOGIN_MAX_FAILURES_PER_ADDRESS=20    # failed sign-ins from one address, any accounts, per 15 minutes
# UPLOAD_LIMIT_CONTENT_MB=50           # course files; Caddy refuses any request over 60 MB
# UPLOAD_LIMIT_SUBMISSION_MB=20        # students' work
# UPLOAD_LIMIT_EVIDENCE_MB=15          # practical photographs and scans (observations, logbook)
# SITE_STORAGE_ALLOWANCE_MB=2048       # files on one course site; a course administrator can change one site
# FORUM_EDIT_MINUTES=30               # how long an author may change or remove their own forum post
# MESSAGING_STUDENT_TO_STUDENT=0       # private messages between students: off unless GSA asks for them
# ATTENDANCE_CODE_SECONDS=60           # how long a check-in code shown in the room is valid
# ATTENDANCE_LATE_AFTER_MINUTES=10     # a check-in this long after the start counts as late
# SIMILARITY_CHECKS=1                  # compare each hand-in with other GSA submissions (item 3.20, ADR 0031)
# OPEN_COURSES_ENABLED=0               # open short courses and self-registration: off until GSA decides (ADR 0032)
# OPEN_REGISTRATIONS_PER_ADDRESS=5     # registrations an hour from one network address
# OPEN_CONFIRM_HOURS=48                # how long a registration link works
# UPLOAD_LIMIT_VIDEO_MB=1024          # a lecture video, put up once; Caddy allows /api/v1/videos/ up to 1100 MB
# VIDEO_STANDARD_HEIGHT=480            # the standard copy's height (720 where the line allows); the low copy is 240
# VIDEO_KEEP_ORIGINAL=0                # keep the file as put up beside its copies (counts against the allowance)
# VIDEO_TRANSCRIBE_COMMAND=            # automatic captions on this server: the whisper.cpp command and model; off when empty
# VAPID_PUBLIC_KEY=                    # push notices: both keys from manage.py vapid_keys; push is off until both are set
# VAPID_PRIVATE_KEY=                   # a server secret
# VAPID_SUBJECT=mailto:lms@gsa.edu.gy  # how a push service can reach GSA
# REPORT_MIN_GROUP=5                   # reports that leave a course hide totals about fewer people (item 6.06)
# OUTCOME_MET_PERCENT=50               # a learning outcome counts as met at this share of its evidence (3.11)
# SRMS_COMPETENCY_PUSH=0               # competency results and outcome standings to the SRMS: off until D8 (6.10)
# API_DOCS_PUBLIC=1                    # API documentation without signing in; defaults to DJANGO_DEBUG
# HELP_REQUESTS_PER_HOUR=5             # help requests one person may send in an hour (item 7.17)
# ORIENTATION_AUTO_ENROL=1             # put each new student on the orientation course at first sign-in (7.16)
# ORIENTATION_SITE_CODE=GSA-LMS-ORIENTATION  # the course seed_orientation makes
# Journey and test stacks only (seed_journeys --fictional); never set on staging or production.
# DEMO_USER_PASSWORD=CHANGE_ME_12_characters_or_more
# DEMO_TOTP_SECRET=CHANGE_ME_32_base32_characters_A_to_Z_2_to_7
# GSA ecosystem (leave empty to run this system on its own)
HRMS_API_URL=http://hrms-api:8000
HRMS_API_KEY=
SRMS_API_URL=http://srms-api:8000
SRMS_API_KEY=
