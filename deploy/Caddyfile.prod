{
	servers {
		# A client has 15 seconds to send a request's headers and keeps an idle connection for 2 minutes.
		# No limit is set on reading a body: a lecture video of up to 1.1 GB over a slow line may take a long
		# time, and request_body below caps its size instead (docs/runbook.md, "Long uploads").
		timeouts {
			read_header 15s
			idle 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip
	# Public host: automatic Let's Encrypt. Isolated LAN: use "tls internal" or a GSA CA certificate.
	# A name such as localhost (the local smoke test) gets Caddy's internal certificate by itself.

	# Nothing the application accepts is larger (course files are at most 50 MB, core/uploads.py), except a
	# lecture video, put up once at this one address (UPLOAD_LIMIT_VIDEO_MB, 1024 MB by default; item 4.06).
	@video_upload path /api/v1/videos/
	@other_upload not path /api/v1/videos/
	request_body @other_upload {
		max_size 60MB
	}
	request_body @video_upload {
		max_size 1100MB
	}

	# Metrics are scraped on the private network (deploy/monitoring/), never from outside (item 7.10).
	handle /api/metrics* {
		respond 404
	}
	# A lecture video: once all of it has arrived, the API stores it before answering, which for 1 GB on a
	# busy disk can take minutes. Only this address waits up to 15 minutes for the answer; everything else
	# waits 60 seconds (gunicorn's threads do not cut a slow request: api/config/gunicorn.py).
	handle /api/v1/videos/ {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
			transport http {
				keepalive 60s
				response_header_timeout 15m
			}
		}
	}
	# X-Real-IP carries the address Caddy itself saw, replacing anything the client sent (core/net.py).
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
			# Close idle connections before gunicorn does (its keep-alive is 75 s), so a request is never
			# sent down a connection the API has just closed (a 502 seen in the load test, item 7.08).
			transport http {
				keepalive 60s
				response_header_timeout 60s
			}
		}
	}
	handle /admin/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
			transport http {
				keepalive 60s
				response_header_timeout 60s
			}
		}
	}
	# The admin site's style sheets and scripts, gathered into the image (collectstatic) and copied into
	# this volume by the "static" service of deploy/compose.prod.yml.
	handle /static/* {
		root * /srv
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		# The package players (items 5.12, 5.13) are loaded by sandboxed frames, whose origin is their own:
		# their fonts and files must be readable across origins. They are public code, never data.
		header /players/* Access-Control-Allow-Origin "*"
		# The web app loads only its own scripts, styles and data. Keep in step with
		# deploy/railway/Caddyfile.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# A default only: the API lets this application frame a hand-in it shows beside the mark (2.23).
		?X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self), payment=(), usb=()"
	}
}
