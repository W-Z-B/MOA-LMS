{
	# Non-standard host port in development: do not redirect HTTP to port 443.
	auto_https disable_redirects
}

# Reverse proxy and TLS. {$DOMAIN} comes from the environment.
# Local development: lms.localhost gets an internal certificate automatically.
# Production on a public name: Caddy obtains and renews a Let's Encrypt certificate.
# Isolated LAN: replace "tls internal" with "tls /certs/gsa.crt /certs/gsa.key".

{$DOMAIN} {
	encode zstd gzip
	tls internal

	# Nothing the application accepts is larger (course files are at most 50 MB, core/uploads.py).
	request_body {
		max_size 60MB
	}

	# X-Real-IP carries the address Caddy itself saw, replacing anything the client sent (core/net.py).
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle /admin/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle /static/* {
		reverse_proxy api:8000
	}
	handle {
		# development: Vite dev server, which needs inline scripts for hot reload, so no
		# Content-Security-Policy here; the production and hosted configurations set one.
		reverse_proxy web:5173
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# A default only: the API lets this application frame a hand-in it shows beside the mark (2.23).
		?X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
